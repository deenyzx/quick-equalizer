{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "quick-equalizer",
  "version": "0.2.0",
  "identifier": "com.cowboy.quick-equalizer",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Quick Equalizer",
    "width": 760,
    "height": 540,
    "decorations": false,
    "transparent": true,
    "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
